[
  {
    "type": "separator",
    "label": "**Apple Intelligence**\n*Uses AFM Server with the fixed model apple.local.*"
  },
  {
    "property": "mod.dia-sidebar.server",
    "label": "AFM Server URL",
    "type": "string",
    "defaultValue": "http://127.0.0.1:11435/v1",
    "placeholder": "http://127.0.0.1:11435/v1"
  },
  {
    "property": "mod.dia-sidebar.apikey",
    "label": "AFM Server API key (only if enabled in AFM Server)",
    "type": "string",
    "defaultValue": "",
    "placeholder": "Leave blank unless AFM Server requires a key"
  },
  {
    "type": "separator",
    "label": "**Chat**"
  },
  {
    "property": "mod.dia-sidebar.style",
    "label": "Answer length",
    "type": "dropdown",
    "defaultValue": "concise",
    "placeholder": false,
    "options": [
      {
        "label": "Concise",
        "value": "concise"
      },
      {
        "label": "Balanced",
        "value": "balanced"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.autosummarize",
    "label": "Summarize automatically",
    "type": "dropdown",
    "defaultValue": "youtube",
    "placeholder": false,
    "options": [
      {
        "label": "YouTube videos only",
        "value": "youtube"
      },
      {
        "label": "Every page",
        "value": "true"
      },
      {
        "label": "Never",
        "value": "false"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.entersends",
    "label": "Press Enter to send  (off: Enter adds a new line, Ctrl/Cmd+Enter sends)",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Context**"
  },
  {
    "property": "mod.dia-sidebar.attachpage",
    "label": "Attach the current page automatically",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.dia-sidebar.attachselection",
    "label": "Attach text I select on the page",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.dia-sidebar.ytstamps",
    "label": "Keep timestamps in YouTube transcripts  (needed for key moments)",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Web search**"
  },
  {
    "property": "mod.dia-sidebar.websearch",
    "label": "Search the web",
    "type": "dropdown",
    "defaultValue": "manual",
    "placeholder": false,
    "options": [
      {
        "label": "Only when I ask (+ menu or @Web)",
        "value": "manual"
      },
      {
        "label": "Off",
        "value": "off"
      }
    ]
  },
  {
    "type": "separator",
    "label": "**Appearance**\n*Drag the sidebar's edge to resize it. Double-click the edge to reset.*"
  },
  {
    "property": "mod.dia-sidebar.side",
    "label": "Sidebar side",
    "type": "dropdown",
    "defaultValue": "right",
    "placeholder": false,
    "options": [
      {
        "label": "Right",
        "value": "right"
      },
      {
        "label": "Left",
        "value": "left"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.accent",
    "label": "Colours",
    "type": "dropdown",
    "defaultValue": "space",
    "placeholder": false,
    "options": [
      {
        "label": "Match my Zen space",
        "value": "space"
      },
      {
        "label": "Neutral",
        "value": "neutral"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.textsize",
    "label": "Text size",
    "type": "dropdown",
    "defaultValue": "medium",
    "placeholder": false,
    "options": [
      {
        "label": "Small",
        "value": "small"
      },
      {
        "label": "Medium",
        "value": "medium"
      },
      {
        "label": "Large",
        "value": "large"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.urlbarbutton",
    "label": "Show the chat button in the URL bar",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Privacy**"
  },
  {
    "property": "mod.dia-sidebar.history",
    "label": "Save chat history on this computer",
    "type": "checkbox",
    "defaultValue": true
  }
]
