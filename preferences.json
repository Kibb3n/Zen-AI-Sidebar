[
  {
    "type": "separator",
    "label": "**AI model**"
  },
  {
    "property": "mod.dia-sidebar.provider",
    "label": "Provider",
    "type": "dropdown",
    "defaultValue": "apple",
    "placeholder": false,
    "options": [
      {
        "label": "Apple Intelligence (on-device, no key)",
        "value": "apple"
      },
      {
        "label": "Anthropic Claude",
        "value": "anthropic"
      },
      {
        "label": "Google Gemini",
        "value": "gemini"
      },
      {
        "label": "OpenAI-compatible (OpenAI, Groq, Ollama)",
        "value": "openai"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.apikey",
    "label": "API key",
    "type": "string",
    "defaultValue": "",
    "placeholder": "Paste your key here",
    "conditions": [
      {
        "not": {
          "property": "mod.dia-sidebar.provider",
          "value": "apple"
        }
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.model",
    "label": "Model",
    "type": "string",
    "defaultValue": "",
    "placeholder": "Leave blank for the best default (Gemini: newest Flash)"
  },
  {
    "property": "mod.dia-sidebar.server",
    "label": "Server address",
    "type": "string",
    "defaultValue": "",
    "placeholder": "Leave blank for the default",
    "conditions": [
      {
        "if": {
          "property": "mod.dia-sidebar.provider",
          "value": "apple"
        }
      },
      {
        "if": {
          "property": "mod.dia-sidebar.provider",
          "value": "openai"
        }
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.thinking",
    "label": "Show thinking",
    "type": "dropdown",
    "defaultValue": "0",
    "placeholder": false,
    "options": [
      {
        "label": "Off",
        "value": "0"
      },
      {
        "label": "Light",
        "value": "2048"
      },
      {
        "label": "Deep",
        "value": "8000"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "mod.dia-sidebar.provider",
          "value": "anthropic"
        }
      },
      {
        "if": {
          "property": "mod.dia-sidebar.provider",
          "value": "gemini"
        }
      }
    ]
  },
  {
    "type": "separator",
    "label": "**Chat**"
  },
  {
    "property": "mod.dia-sidebar.style",
    "label": "Answer length",
    "type": "dropdown",
    "defaultValue": "concise",
    "placeholder": false,
    "options": [
      {
        "label": "Concise",
        "value": "concise"
      },
      {
        "label": "Balanced",
        "value": "balanced"
      },
      {
        "label": "Detailed",
        "value": "detailed"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.language",
    "label": "Reply language",
    "type": "string",
    "defaultValue": "",
    "placeholder": "Blank = the language I write in"
  },
  {
    "property": "mod.dia-sidebar.instructions",
    "label": "Custom instructions",
    "type": "string",
    "defaultValue": "",
    "placeholder": "e.g. Keep it casual. Use British spelling."
  },
  {
    "property": "mod.dia-sidebar.autosummarize",
    "label": "Summarize automatically",
    "type": "dropdown",
    "defaultValue": "youtube",
    "placeholder": false,
    "options": [
      {
        "label": "YouTube videos only",
        "value": "youtube"
      },
      {
        "label": "Every page",
        "value": "true"
      },
      {
        "label": "Never",
        "value": "false"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.entersends",
    "label": "Press Enter to send  (off: Enter adds a new line, Ctrl/Cmd+Enter sends)",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Context**"
  },
  {
    "property": "mod.dia-sidebar.attachpage",
    "label": "Attach the current page automatically",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.dia-sidebar.attachselection",
    "label": "Attach text I select on the page",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.dia-sidebar.ytstamps",
    "label": "Keep timestamps in YouTube transcripts  (needed for key moments)",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Web search**"
  },
  {
    "property": "mod.dia-sidebar.websearch",
    "label": "Search the web",
    "type": "dropdown",
    "defaultValue": "auto",
    "placeholder": false,
    "options": [
      {
        "label": "Automatic (recommended)",
        "value": "auto"
      },
      {
        "label": "Only when I ask (+ menu or @Web)",
        "value": "manual"
      },
      {
        "label": "Off",
        "value": "off"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.searchengine",
    "label": "Search engine",
    "type": "dropdown",
    "defaultValue": "duckduckgo",
    "placeholder": false,
    "options": [
      {
        "label": "DuckDuckGo",
        "value": "duckduckgo"
      },
      {
        "label": "Brave Search",
        "value": "brave"
      },
      {
        "label": "SearXNG",
        "value": "searxng"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "mod.dia-sidebar.provider",
          "value": "apple"
        }
      },
      {
        "if": {
          "property": "mod.dia-sidebar.provider",
          "value": "openai"
        }
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.searchsetup",
    "label": "Brave API key or SearXNG address",
    "type": "string",
    "defaultValue": "",
    "placeholder": "Only needed for Brave or SearXNG",
    "conditions": [
      {
        "not": {
          "property": "mod.dia-sidebar.searchengine",
          "value": "duckduckgo"
        }
      }
    ]
  },
  {
    "type": "separator",
    "label": "**Appearance**\n*Drag the sidebar's edge to resize it. Double-click the edge to reset.*"
  },
  {
    "property": "mod.dia-sidebar.side",
    "label": "Sidebar side",
    "type": "dropdown",
    "defaultValue": "right",
    "placeholder": false,
    "options": [
      {
        "label": "Right",
        "value": "right"
      },
      {
        "label": "Left",
        "value": "left"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.accent",
    "label": "Colours",
    "type": "dropdown",
    "defaultValue": "space",
    "placeholder": false,
    "options": [
      {
        "label": "Match my Zen space",
        "value": "space"
      },
      {
        "label": "Neutral",
        "value": "neutral"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.textsize",
    "label": "Text size",
    "type": "dropdown",
    "defaultValue": "medium",
    "placeholder": false,
    "options": [
      {
        "label": "Small",
        "value": "small"
      },
      {
        "label": "Medium",
        "value": "medium"
      },
      {
        "label": "Large",
        "value": "large"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.urlbarbutton",
    "label": "Show the chat button in the URL bar",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Privacy**"
  },
  {
    "property": "mod.dia-sidebar.history",
    "label": "Save chat history on this computer",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Advanced**"
  },
  {
    "property": "mod.dia-sidebar.prompt",
    "label": "Summarize instruction",
    "type": "string",
    "defaultValue": "Summarize this page into concise bullet points."
  },
  {
    "property": "mod.dia-sidebar.maxchars",
    "label": "Page text limit (characters)",
    "type": "string",
    "defaultValue": "",
    "placeholder": "Blank = automatic"
  }
]