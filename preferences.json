[
  {
    "type": "separator",
    "label": "**Chat**\n*The assistant only searches the internet while the globe button is on. Otherwise it uses just the page you're on and the links on that page.*"
  },
  {
    "property": "mod.dia-sidebar.autosummarize",
    "label": "Summarize automatically",
    "type": "dropdown",
    "defaultValue": "youtube",
    "placeholder": false,
    "options": [
      {
        "label": "YouTube videos only",
        "value": "youtube"
      },
      {
        "label": "Every page",
        "value": "true"
      },
      {
        "label": "Never",
        "value": "false"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.entersends",
    "label": "Press Enter to send (off: Cmd/Ctrl+Enter sends)",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Search provider**\n*Used when the globe is on. Configured alternatives are tried automatically if a search is unavailable or rate-limited.*"
  },
  {
    "property": "mod.dia-sidebar.searchmode",
    "label": "How the assistant searches",
    "type": "dropdown",
    "defaultValue": "own",
    "placeholder": false,
    "options": [
      {
        "label": "Writes its own queries from the conversation (recommended)",
        "value": "own"
      },
      {
        "label": "Gemini / Claude's built-in search (picks its own queries)",
        "value": "builtin"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.searchengine",
    "label": "Preferred search provider",
    "type": "dropdown",
    "defaultValue": "duckduckgo",
    "placeholder": false,
    "options": [
      {
        "label": "DuckDuckGo",
        "value": "duckduckgo"
      },
      {
        "label": "Google Search",
        "value": "google"
      },
      {
        "label": "Brave Search",
        "value": "brave"
      },
      {
        "label": "SearXNG",
        "value": "searxng"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.searchkey",
    "label": "Brave Search API key (optional fallback)",
    "type": "string",
    "defaultValue": "",
    "placeholder": "Paste your Brave Search API key"
  },
  {
    "property": "mod.dia-sidebar.searxurl",
    "label": "SearXNG address (optional fallback)",
    "type": "string",
    "defaultValue": "",
    "placeholder": "https://your-searxng.example"
  },
  {
    "type": "separator",
    "label": "**Context**"
  },
  {
    "property": "mod.dia-sidebar.attachpage",
    "label": "Attach the current page automatically",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.dia-sidebar.attachselection",
    "label": "Attach text I select on the page",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Appearance**"
  },
  {
    "property": "mod.dia-sidebar.accent",
    "label": "Colours",
    "type": "dropdown",
    "defaultValue": "space",
    "placeholder": false,
    "options": [
      {
        "label": "Match my Zen space",
        "value": "space"
      },
      {
        "label": "Neutral",
        "value": "neutral"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.textsize",
    "label": "Text size",
    "type": "dropdown",
    "defaultValue": "medium",
    "placeholder": false,
    "options": [
      {
        "label": "Small",
        "value": "small"
      },
      {
        "label": "Medium",
        "value": "medium"
      },
      {
        "label": "Large",
        "value": "large"
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.urlbarbutton",
    "label": "Show the chat button in the URL bar",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Privacy**"
  },
  {
    "property": "mod.dia-sidebar.history",
    "label": "Save chat history on this computer",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "**Setup**\n*Pick models and set effort from the model menu at the top of the sidebar.*"
  },
  {
    "property": "mod.dia-sidebar.rerunsetup",
    "label": "Run the setup guide again (removes models you added)",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "**Advanced**"
  },
  {
    "property": "mod.dia-sidebar.advanced",
    "label": "Show advanced options",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "**Apple Intelligence server**\n*Only for AFM Server. Other models are added from the sidebar.*",
    "id": "dia-adv-sep",
    "conditions": [
      {
        "if": {
          "property": "mod.dia-sidebar.advanced",
          "value": true
        }
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.server",
    "label": "AFM Server address",
    "type": "string",
    "defaultValue": "http://127.0.0.1:11435/v1",
    "placeholder": "http://127.0.0.1:11435/v1",
    "conditions": [
      {
        "if": {
          "property": "mod.dia-sidebar.advanced",
          "value": true
        }
      }
    ]
  },
  {
    "property": "mod.dia-sidebar.apikey",
    "label": "AFM Server API key",
    "type": "string",
    "defaultValue": "",
    "placeholder": "Leave blank unless AFM Server asks for one",
    "conditions": [
      {
        "if": {
          "property": "mod.dia-sidebar.advanced",
          "value": true
        }
      }
    ]
  }
]